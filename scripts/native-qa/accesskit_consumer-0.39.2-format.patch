+    /// Visits this range one text run at a time, in document order or in
+    /// reverse. Each subrange is clipped to the original endpoints. A
+    /// degenerate range is visited once with its original caret affinity.
+    /// Returning `Some` ends the traversal and returns that result.
+    pub fn traverse_runs<F, T>(&self, backward: bool, mut f: F) -> Option<T>
+    where
+        F: FnMut(Self) -> Option<T>,
+    {
+        if self.is_degenerate() {
+            return f(*self);
+        }
+        self.walk_nodes(backward, |node| {
+            let start = if node.id() == self.start.node.id() {
+                self.start.character_index
+            } else {
+                0
+            };
+            let end = if node.id() == self.end.node.id() {
+                self.end.character_index
+            } else {
+                node.data().character_lengths().len()
+            };
+            if start == end {
+                return None;
+            }
+            f(Self {
+                node: self.node,
+                start: InnerPosition {
+                    node,
+                    character_index: start,
+                },
+                end: InnerPosition {
+                    node,
+                    character_index: end,
+                },
+            })
