diff --git a/src/atspi/interfaces/hypertext.rs b/src/atspi/interfaces/hypertext.rs
new file mode 100644
index 0000000..43e0df6
--- /dev/null
+++ b/src/atspi/interfaces/hypertext.rs
@@ -0,0 +1,55 @@
+// Copyright 2026 The AccessKit Authors. All rights reserved.
+// Licensed under the Apache License, Version 2.0 (found in
+// the LICENSE-APACHE file) or the MIT license (found in
+// the LICENSE-MIT file), at your option.
+// Hypertext implementation copyright 2026 The Textloom Authors (MIT).
+
+use accesskit_atspi_common::PlatformNode;
+use zbus::{fdo, interface, names::OwnedUniqueName};
+
+use crate::atspi::{OwnedObjectAddress, hyperlink_path};
+
+pub(crate) struct HypertextInterface {
+    bus_name: OwnedUniqueName,
+    node: PlatformNode,
+}
+
+impl HypertextInterface {
+    pub fn new(bus_name: OwnedUniqueName, node: PlatformNode) -> Self {
+        Self { bus_name, node }
+    }
+
+    fn map_error(&self) -> impl '_ + FnOnce(accesskit_atspi_common::Error) -> fdo::Error {
+        |error| crate::util::map_error_from_node(&self.node, error)
+    }
+}
+
+#[interface(name = "org.a11y.atspi.Hypertext")]
+impl HypertextInterface {
+    #[zbus(property, name = "version")]
+    fn version(&self) -> u32 {
+        1
+    }
+
+    #[zbus(name = "GetNLinks")]
+    fn get_n_links(&self) -> fdo::Result<i32> {
+        self.node.n_links().map_err(self.map_error())
+    }
+
+    pub(super) fn get_link(&self, index: i32) -> fdo::Result<(OwnedObjectAddress,)> {
+        let link = self.node.link_at_index(index).map_err(self.map_error())?;
+        // libatspi resolves the bus name before recognizing the null path.
+        Ok((match link {
+            Some(id) => {
+                OwnedObjectAddress::new(&self.bus_name, hyperlink_path(self.node.adapter_id(), id))
+            }
+            None => OwnedObjectAddress::null_in(&self.bus_name),
+        },))
+    }
+
+    fn get_link_index(&self, offset: i32) -> fdo::Result<i32> {
+        self.node
+            .link_index_at_offset(offset)
+            .map_err(self.map_error())
+    }
+}
