+    #[test]
+    fn hypertext_returns_distinct_proxy_and_anchor_paths_and_named_nulls() {
+        use crate::atspi::{
+            OwnedObjectAddress, hyperlink_path,
+            interfaces::{HyperlinkInterface, HypertextInterface},
+        };
+        use zbus::zvariant::ObjectPath;
+
+        let mut link = with_children(Role::Link, &[NodeId(2)]);
+        link.set_url("https://example.com");
+        let mut text = Node::new(Role::TextRun);
+        text.set_value("x");
+        text.set_character_lengths(vec![1]);
+        let mut tree = window_with_button();
+        tree.nodes = vec![
+            (
+                NodeId(0),
+                with_children(Role::MultilineTextInput, &[NodeId(1)]),
+            ),
+            (NodeId(1), link),
+            (NodeId(2), text),
+        ];
+        let (adapter, _) = root_for(tree);
+        let doc = adapter.platform_node(adapter.root_id());
+        let anchor = adapter.platform_node(doc.child_at_index(0).unwrap().unwrap());
+        let bus_name = OwnedUniqueName::try_from(BUS_NAME).unwrap();
+        let text = HypertextInterface::new(bus_name.clone(), doc);
+        let link = HyperlinkInterface::new(bus_name.clone(), anchor.clone());
+        let proxy = text.get_link(0).unwrap().0;
+        let accessible = link.get_object(0).unwrap().0;
+        assert_eq!(accessible, ObjectId::from(&anchor).to_address(&bus_name));
+        assert_eq!(
+            proxy,
+            OwnedObjectAddress::new(&bus_name, hyperlink_path(anchor.adapter_id(), anchor.id()))
+        );
+        assert_ne!(proxy, accessible);
+        let null = OwnedObjectAddress::new(
+            &bus_name,
+            ObjectPath::try_from("/org/a11y/atspi/null").unwrap().into(),
+        );
+        for invalid_index in [-1, 1] {
+            assert_eq!(text.get_link(invalid_index).unwrap().0, null);
+        }
+    }
