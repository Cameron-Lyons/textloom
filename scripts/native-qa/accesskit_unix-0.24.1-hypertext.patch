diff --git a/src/atspi/object_id.rs b/src/atspi/object_id.rs
index e65ceda..e9af687 100644
--- a/src/atspi/object_id.rs
+++ b/src/atspi/object_id.rs
@@ -15,6 +15,16 @@ const ACCESSIBLE_PATH_PREFIX: &str = "/org/a11y/atspi/accessible/";
 const ROOT_PATH: &str = "/org/a11y/atspi/accessible/root";
 const CACHE_PATH: &str = "/org/a11y/atspi/cache";
 
+// libatspi interns Accessible and Hyperlink objects in one path-keyed table.
+// The Hyperlink proxy and the Accessible returned by GetObject must be distinct.
+pub(crate) fn hyperlink_path(adapter: usize, node: FullNodeId) -> OwnedObjectPath {
+    ObjectPath::from_string_unchecked(format!(
+        "/org/a11y/atspi/hyperlink/{adapter}/{}",
+        u128::from(node)
+    ))
+    .into()
+}
+
 pub(crate) fn cache_path() -> OwnedObjectPath {
     ObjectPath::from_str_unchecked(CACHE_PATH).into()
 }
