+/// Queue each changed contact once. Only the first eligible touch moves egui's pointer.
+pub fn push_touches(
+    runner: &mut AppRunner,
+    phase: egui::TouchPhase,
+    event: &web_sys::TouchEvent,
+) -> Option<egui::Pos2> {
+    use super::PrimaryOwner;
+    let changed = event.changed_touches();
+    if phase == egui::TouchPhase::Start
+        && runner.input.primary_owner.is_none()
+        && event.target_touches().length() == changed.length()
+    {
+        if let Some(touch) = changed.item(0) {
+            runner
+                .input
+                .claim_primary(PrimaryOwner::Touch(touch.identifier().into()));
         }
     }
+    let origin = canvas_content_origin(runner.canvas());
+    let mut primary = None;
+    for touch in (0..changed.length()).filter_map(|index| changed.item(index)) {
+        let id = touch.identifier().into();
+        let pos = pos_from_touch(origin, &touch, runner.egui_ctx());
+        if runner.input.push_touch(id, phase, pos, touch.force())
+            && runner.input.primary_owner == Some(PrimaryOwner::Touch(id))
+        {
+            primary = Some(pos);
+        }
+    }
+    if primary.is_some() && matches!(phase, egui::TouchPhase::End | egui::TouchPhase::Cancel) {
+        runner.input.primary_owner = None;
+    }
+    primary
