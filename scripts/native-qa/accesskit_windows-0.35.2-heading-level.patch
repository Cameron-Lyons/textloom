+// Text clients query the document range, whose runs may sit under a link
+// or other inline container inside a heading. Stop at this text provider.
+fn run_style_id(run: &NodeRef, owner: &NodeRef) -> i32 {
+    let mut node = *run;
+    loop {
+        match node.role() {
+            Role::Heading => {
+                return crate::node::heading_index(&node)
+                    .map_or(StyleId_Custom.0, |level| StyleId_Heading1.0 + level as i32);
+            }
+            Role::Blockquote => return StyleId_Quote.0,
+            Role::ListItem => {
+                return match node.data().list_style() {
+                    Some(ListStyle::Numeric) => StyleId_NumberedList.0,
+                    Some(
+                        ListStyle::Circle | ListStyle::Disc | ListStyle::Square | ListStyle::Image,
+                    ) => StyleId_BulletedList.0,
+                    _ => StyleId_Custom.0,
+                };
+            }
+            _ => {}
+        }
+        if node.id() == owner.id() {
+            break;
+        }
+        let Some(parent) = node.parent() else { break };
+        node = parent;
+    }
+    StyleId_Normal.0
+}
+
+fn range_style_id(range: &Range) -> TextRangePropertyValue<i32> {
+    let mut first = None;
+    let mixed = range.traverse_runs(false, |run| {
+        let style = run_style_id(run.start().inner_node(), range.node());
+        (*first.get_or_insert(style) != style).then_some(())
+    });
+    if mixed.is_some() {
+        TextRangePropertyValue::Mixed
+    } else {
+        TextRangePropertyValue::Single(first.unwrap_or(StyleId_Normal.0))
+    }
+}
+
+fn find_style<'a>(range: &Range<'a>, wanted: i32, backward: bool) -> Option<Range<'a>> {
+    let mut first = None;
+    let mut last = None;
+    range.traverse_runs(backward, |run| {
+        if run_style_id(run.start().inner_node(), range.node()) == wanted {
+            first.get_or_insert(run);
+            last = Some(run);
+            None
+        } else {
+            first.is_some().then_some(())
+        }
+    });
+    let mut found = first?;
+    if backward {
+        found.set_start(last?.start());
+    } else {
+        found.set_end(last?.end());
+    }
+    Some(found)
+}
+
+fn is_format_start(pos: Position) -> bool {
+    if pos.is_format_start() {
+        return true;
+    }
+    let previous = pos.biased_to_end();
+    let node = pos.inner_node();
+    let before = previous.inner_node();
+    if before.id() == node.id() {
+        return false;
+    }
+    let range = pos.to_degenerate_range();
+    run_style_id(node, range.node()) != run_style_id(before, range.node())
+}
+
+// A Format unit ends at the first change of any supported format attribute,
+// including the semantic style inherited from a heading or other block.
+fn format_boundary(pos: Position, backward: bool) -> Position {
+    let mut range = pos.to_degenerate_range();
+    let limit = if backward {
+        let start = pos.document_start();
+        range.set_start(start);
+        start
+    } else {
+        let end = pos.document_end();
+        range.set_end(end);
+        end
+    };
+    let mut skip_current = !backward;
+    range
+        .traverse_runs(backward, |run| {
+            if std::mem::take(&mut skip_current) {
+                return None;
+            }
+            let start = run.start();
+            is_format_start(start).then_some(start)
+        })
+        .unwrap_or(limit)
+}
