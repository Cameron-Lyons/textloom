+// AccessKit stores zero-based levels. UIA defines nine heading identifiers.
+pub(crate) fn heading_index(node: &NodeRef<'_>) -> Option<usize> {
+    if node.role() != Role::Heading {
+        return None;
+    }
+    node.level().filter(|index| *index < 9)
+}
