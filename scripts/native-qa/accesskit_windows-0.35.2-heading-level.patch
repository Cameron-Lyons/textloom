+#[cfg(test)]
+mod heading_tests {
+    use super::*;
+    use accesskit::{Node, TreeInfo, TreeUpdate};
+
+    #[test]
+    fn heading_level_property_uses_uia_ids_only_for_valid_headings() {
+        fn property(role: Role, level: Option<usize>) -> Option<i32> {
+            let id = NodeId(42);
+            let mut node = Node::new(role);
+            if let Some(level) = level {
+                node.set_level(level);
+            }
+            let tree = Tree::new(
+                TreeUpdate {
+                    nodes: vec![(id, node)],
+                    tree: Some(TreeInfo::new(id)),
+                    tree_id: TreeId::ROOT,
+                    focus: id,
+                },
+                true,
+            );
+            let node = tree.state().root();
+            NodeWrapper {
+                node: &node,
+                string_buffer: &mut Vec::new(),
+            }
+            .heading_level()
+        }
+
+        for (index, expected) in [
+            HeadingLevel1,
+            HeadingLevel2,
+            HeadingLevel3,
+            HeadingLevel4,
+            HeadingLevel5,
+            HeadingLevel6,
+            HeadingLevel7,
+            HeadingLevel8,
+            HeadingLevel9,
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            assert_eq!(property(Role::Heading, Some(index)), Some(expected.0));
+        }
+        for level in [None, Some(9), Some(usize::MAX)] {
+            assert_eq!(property(Role::Heading, level), None);
+        }
+        for role in [Role::Paragraph, Role::ListItem] {
+            assert_eq!(property(role, Some(0)), None);
+        }
+    }
+}
