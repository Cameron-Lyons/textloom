+#[cfg(test)]
+mod style_tests {
+    use super::*;
+    use accesskit::{Node, NodeId, TreeId, TreeInfo, TreeUpdate};
+
+    #[test]
+    fn heading_ranges_cover_linked_runs_and_respect_search_bounds() {
+        fn parent(role: Role, children: &[u64]) -> Node {
+            let mut node = Node::new(role);
+            node.set_children(children.iter().copied().map(NodeId).collect::<Vec<_>>());
+            node
+        }
+        fn run(s: &str, lengths: &[u8]) -> Node {
+            let mut node = Node::new(Role::TextRun);
+            node.set_value(s);
+            node.set_character_lengths(lengths.to_vec());
+            node
+        }
+        let mut bold = run("🦀", &[4]);
+        bold.set_font_weight(700.0);
+        let mut heading = parent(Role::Heading, &[2, 3, 5]);
+        heading.set_level(0);
+        let mut second_heading = parent(Role::Heading, &[8]);
+        second_heading.set_level(0);
+        let mut empty_heading = parent(Role::Heading, &[10]);
+        empty_heading.set_level(5);
+        let root = NodeId(0);
+        let tree = Tree::new(
+            TreeUpdate {
+                nodes: vec![
+                    (root, parent(Role::MultilineTextInput, &[1, 6, 7, 9])),
+                    (NodeId(1), heading),
+                    (NodeId(2), bold),
+                    (NodeId(3), parent(Role::Link, &[4])),
+                    (NodeId(4), run("e\u{301}", &[3])),
+                    (NodeId(5), run("\n", &[1])),
+                    (NodeId(6), run("body\n", &[1; 5])),
+                    (NodeId(7), second_heading),
+                    (NodeId(8), run("x\n", &[1, 1])),
+                    (NodeId(9), empty_heading),
+                    (NodeId(10), run("", &[])),
+                ],
+                tree: Some(TreeInfo::new(root)),
+                tree_id: TreeId::ROOT,
+                focus: root,
+            },
+            true,
+        );
+        let doc = tree.state().root();
+        let range = doc.document_range();
+        let style = StyleId_Heading1.0;
+        assert_eq!(range_style_id(&range), TextRangePropertyValue::Mixed);
+        let first = find_style(&range, style, false).unwrap();
+        assert_eq!(first.text(), "🦀e\u{301}\n");
+        assert_eq!(
+            range_style_id(&first),
+            TextRangePropertyValue::Single(style)
+        );
+        assert_eq!(find_style(&range, style, true).unwrap().text(), "x\n");
+        assert_eq!(
+            find_style(&range, StyleId_Normal.0, false).unwrap().text(),
+            "body\n"
+        );
+        assert!(find_style(&range, StyleId_Heading2.0, true).is_none());
+        let mut clipped = range;
+        clipped.set_start(doc.text_position_from_global_usv_index(1).unwrap());
+        clipped.set_end(doc.text_position_from_global_usv_index(3).unwrap());
+        assert_eq!(
+            find_style(&clipped, style, true).unwrap().text(),
+            "e\u{301}"
+        );
+        // The inline font changes after the crab. The heading and the body
+        // then have identical visual attributes across their block boundary.
+        let pos = |offset| doc.text_position_from_global_usv_index(offset).unwrap();
+        for (start, end) in [(0, 1), (1, 4), (4, 9), (9, 11)] {
+            assert!(is_format_start(pos(start)));
+            assert_eq!(
+                format_boundary(pos(start), false).to_global_usv_index(),
+                end
+            );
+            assert_eq!(format_boundary(pos(end), true).to_global_usv_index(), start);
+        }
+        assert!(!is_format_start(pos(3)));
+        assert_eq!(format_boundary(pos(3), false).to_global_usv_index(), 4);
+        assert_eq!(format_boundary(pos(3), true).to_global_usv_index(), 1);
+        let empty = doc.document_end().to_degenerate_range();
+        assert_eq!(
+            range_style_id(&empty),
+            TextRangePropertyValue::Single(StyleId_Heading6.0)
+        );
+        assert!(find_style(&empty, StyleId_Heading6.0, false) == Some(empty));
+    }
+}
