+    fn with_hypertext<T>(
+        &self,
+        f: impl FnOnce(&crate::hypertext::Links) -> Result<T>,
+    ) -> Result<T> {
+        self.resolve_for_text_with_context(|node, _, context| {
+            if node.is_password_input() {
+                return Err(Error::UnsupportedInterface);
+            }
+            context.hypertext.with(&node, f)
+        })
+    }
+
+    pub fn supports_hypertext(&self) -> Result<bool> {
+        self.resolve(|node| Ok(node.supports_text_ranges() && !node.is_password_input()))
+    }
+
+    pub fn n_links(&self) -> Result<i32> {
+        self.with_hypertext(|links| links.count().try_into().map_err(|_| Error::TooManyChildren))
+    }
+
+    pub fn link_at_index(&self, index: i32) -> Result<Option<FullNodeId>> {
+        self.with_hypertext(|links| Ok(usize::try_from(index).ok().and_then(|i| links.id_at(i))))
+    }
+
+    pub fn link_index_at_offset(&self, offset: i32) -> Result<i32> {
+        self.with_hypertext(|links| {
+            match usize::try_from(offset).ok().and_then(|i| links.index_at(i)) {
+                Some(index) => index.try_into().map_err(|_| Error::TooManyChildren),
+                None => Ok(-1),
+            }
+        })
+    }
+
+    fn hyperlink_range(&self) -> Result<Option<std::ops::Range<usize>>> {
+        self.resolve_with_context(|node, _, context| {
+            let mut parent = node.parent();
+            while let Some(owner) = parent {
+                if owner.supports_text_ranges() {
+                    return Ok(if owner.is_password_input() {
+                        None
+                    } else {
+                        context
+                            .hypertext
+                            .with(&owner, |links| links.range(node.id()))
+                    });
+                }
+                parent = owner.parent();
+            }
+            Ok(None)
+        })
+    }
+
     pub fn hyperlink_start_index(&self) -> Result<i32> {
-        self.resolve(|_| {
