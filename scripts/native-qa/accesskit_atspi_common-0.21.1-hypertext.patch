+// Copyright 2026 The Textloom Authors.
+// SPDX-License-Identifier: MIT
+
+use accesskit::Role;
+use accesskit_consumer::{FilterResult, FullNodeId, NodeRef};
+use std::{collections::HashMap, ops::Range, sync::Mutex};
+
+use crate::filters::filter;
+
+/// Orca enumerates a text object's links and asks each for both endpoints.
+/// Keep one lazily built index so those requests do not repeatedly walk the text.
+#[derive(Default)]
+pub(crate) struct Cache(Mutex<Option<(FullNodeId, Links)>>);
+
+impl Cache {
+    // Both reading the index and invalidating it take place under the tree lock.
+    pub(crate) fn invalidate(&self) {
+        self.0.lock().unwrap().take();
+    }
+
+    pub(crate) fn with<T>(&self, owner: &NodeRef, f: impl FnOnce(&Links) -> T) -> T {
+        let mut index = self.0.lock().unwrap();
+        if let Some((id, links)) = index.as_ref() {
+            if *id == owner.id() {
+                return f(links);
+            }
+        }
+        f(&index.insert((owner.id(), Links::new(owner))).1)
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct Links {
+    ordered: Vec<(FullNodeId, Range<usize>)>,
+    by_id: HashMap<FullNodeId, usize>,
+}
+
+impl Links {
+    fn new(owner: &NodeRef) -> Self {
+        let mut result = Self::default();
+        let mut offset = 0;
+        // Mirror the consumer's TextRun traversal so every offset uses the
+        // same Unicode scalar coordinates as the AT-SPI Text interface.
+        let runs = owner.filtered_children(|node| {
+            if node.id() == owner.id() || node.role() == Role::TextRun {
+                FilterResult::Include
+            } else {
+                FilterResult::ExcludeNode
+            }
+        });
+        for run in runs {
+            let start = offset;
+            offset += run.data().value().unwrap_or_default().chars().count();
+            if start == offset {
+                continue;
+            }
+            let mut link = None;
+            let mut parent = run.parent();
+            while let Some(node) = parent {
+                if node.id() == owner.id() {
+                    break;
+                }
+                // A nested text provider owns its own links. An outer link
+                // can itself contain a label or other text provider.
+                if node.supports_text_ranges() {
+                    link = None;
+                } else if node.supports_url() && filter(&node) == FilterResult::Include {
+                    // An outer hyperlink owns its entire interval; nested links
+                    // cannot have overlapping indices in the same text object.
+                    link = Some(node.id());
+                } else if link.is_some() && filter(&node) == FilterResult::ExcludeSubtree {
+                    // Transparent containers can hide an excluded ancestor from
+                    // a link's own filter result. Only return registered objects.
+                    link = None;
+                }
+                parent = node.parent();
+            }
+            if let Some(id) = link {
+                if let Some((last_id, range)) = result.ordered.last_mut() {
+                    if *last_id == id {
+                        range.end = offset;
+                        continue;
+                    }
+                }
+                result.by_id.insert(id, result.ordered.len());
+                result.ordered.push((id, start..offset));
+            }
+        }
+        result
+    }
+
+    pub(crate) fn count(&self) -> usize {
+        self.ordered.len()
+    }
+
+    pub(crate) fn id_at(&self, index: usize) -> Option<FullNodeId> {
+        self.ordered.get(index).map(|(id, _)| *id)
+    }
+
+    pub(crate) fn index_at(&self, offset: usize) -> Option<usize> {
+        let index = self
+            .ordered
+            .partition_point(|(_, range)| range.end <= offset);
+        self.ordered
+            .get(index)
+            .filter(|(_, range)| range.contains(&offset))
+            .map(|_| index)
+    }
+
+    pub(crate) fn range(&self, id: FullNodeId) -> Option<Range<usize>> {
+        self.by_id
+            .get(&id)
+            .map(|&index| self.ordered[index].1.clone())
+    }
+}
