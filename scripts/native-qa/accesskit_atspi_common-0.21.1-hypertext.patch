     pub fn hyperlink_end_index(&self) -> Result<i32> {
-        self.resolve(|_| {
-            // TODO: Support rich text
-            Ok(-1)
+        self.hyperlink_range()?.map_or(Ok(-1), |range| {
+            range.end.try_into().map_err(|_| Error::TooManyCharacters)
         })
     }
 
