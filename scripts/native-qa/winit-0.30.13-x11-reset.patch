diff --git a/src/platform_impl/linux/x11/ime/mod.rs b/src/platform_impl/linux/x11/ime/mod.rs
index f1f5814..b3e6cb8 100644
--- a/src/platform_impl/linux/x11/ime/mod.rs
+++ b/src/platform_impl/linux/x11/ime/mod.rs
@@ -194,6 +194,29 @@ impl Ime {
         }
     }
 
+    pub fn reset_fcitx_if_allowed(&mut self, window: ffi::Window) -> bool {
+        let Some(Some(context)) = self.inner.contexts.get(&window) else {
+            return false;
+        };
+        // Other providers can send a commit on reset even if the user hasn't
+        // confirmed the preedit. Keep their original interruption behavior.
+        let is_fcitx = self.inner.im.as_ref().is_some_and(|im| im.is_fcitx);
+        if !is_fcitx || self.is_destroyed() || !context.is_allowed() {
+            return false;
+        }
+
+        // Xlib returns the pending preedit on reset. It wasn't confirmed by the
+        // user, and real commits still arrive through the normal key-event path.
+        let preedit = unsafe { (self.xconn.xlib.Xutf8ResetIC)(context.ic) };
+        drop(util::memory::XSmartPointer::new(&self.xconn, preedit));
+
+        // Preserve the public events that the original allow requests generated.
+        for event in [ImeEvent::Disabled, ImeEvent::Enabled] {
+            self.inner.event_sender.send((window, event)).expect("Failed to send IME update");
+        }
+        true
+    }
+
     pub fn set_ime_allowed(
         &mut self,
         window: ffi::Window,
