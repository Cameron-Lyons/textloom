+fn uses_fcitx(modifiers: &[u8]) -> bool {
+    modifiers
+        .split(|byte| *byte == b'@')
+        .skip(1)
+        .find_map(|modifier| modifier.strip_prefix(b"im="))
+        == Some(&b"fcitx"[..])
