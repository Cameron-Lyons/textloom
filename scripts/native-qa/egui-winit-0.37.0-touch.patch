+#[cfg(test)]
+mod pointer_capture_tests {
+    use super::*;
+    use egui::{Event, PointerButton, TouchPhase, pos2};
+    use winit::event::{
+        DeviceId,
+        ElementState::{Pressed, Released},
+        MouseButton,
+    };
+
+    struct Headless;
+    impl HasDisplayHandle for Headless {
+        fn display_handle(
+            &self,
+        ) -> Result<raw_window_handle::DisplayHandle<'_>, raw_window_handle::HandleError> {
+            Err(raw_window_handle::HandleError::Unavailable)
+        }
+    }
+
+    fn state() -> State {
+        State::new(
+            egui::Context::default(),
+            ViewportId::ROOT,
+            &Headless,
+            None,
+            None,
+            None,
+        )
+    }
+
+    fn touch(s: &mut State, id: u64, phase: TouchPhase, x: f32) {
+        s.touch_at(
+            egui::TouchDeviceId(1),
+            egui::TouchId(id),
+            phase,
+            pos2(x, 40.0),
+            None,
+        );
+    }
+
+    fn frame(state: &mut State) {
+        let raw = state.egui_input.take();
+        state.egui_ctx.run_ui(raw, |_| {}).textures_delta.clear();
+    }
+
+    #[test]
+    fn mouse_capture_survives_touch_and_cursor_departure_without_more_motion() {
+        let mut s = state();
+        let mouse = DeviceId::dummy();
+        let pos = pos2(12.0, 16.0);
+        s.on_cursor_moved(mouse, pos);
+        s.on_mouse_button_input(mouse, Pressed, MouseButton::Left);
+        frame(&mut s);
+        s.on_cursor_left();
+        touch(&mut s, 7, TouchPhase::Start, 80.0);
+        touch(&mut s, 7, TouchPhase::End, 80.0);
+        s.on_mouse_button_input(mouse, Released, MouseButton::Left);
+        assert!(matches!(s.egui_input.events.as_slice(), [
+            Event::Touch { phase: TouchPhase::Start, .. },
+            Event::Touch { phase: TouchPhase::End, .. },
+            Event::PointerButton { pos: release, pressed: false, .. }, Event::PointerGone
+        ] if *release == pos));
+        frame(&mut s);
+        assert!(!s.egui_ctx.input(|i| i.pointer.any_down()));
+    }
+
+    #[test]
+    fn touch_capture_ignores_unrelated_motion_and_secondary_contacts() {
+        let mut s = state();
+        let mouse = DeviceId::dummy();
+        touch(&mut s, 1, TouchPhase::Start, 10.0);
+        frame(&mut s);
+        s.on_cursor_moved(mouse, pos2(60.0, 0.0));
+        s.on_mouse_button_input(mouse, Pressed, MouseButton::Left);
+        s.on_mouse_button_input(mouse, Released, MouseButton::Left);
+        touch(&mut s, 2, TouchPhase::Start, 80.0);
+        touch(&mut s, 2, TouchPhase::End, 80.0);
+        assert!(
+            s.egui_input
+                .events
+                .iter()
+                .all(|event| matches!(event, Event::Touch { .. }))
+        );
+        touch(&mut s, 1, TouchPhase::Move, 12.0);
+        frame(&mut s);
+        assert!(s.egui_ctx.input(
+            |i| i.pointer.primary_down() && i.pointer.latest_pos() == Some(pos2(12.0, 40.0))
+        ));
+        touch(&mut s, 1, TouchPhase::End, 14.0);
+        frame(&mut s);
+        assert!(!s.egui_ctx.input(|i| i.pointer.any_down()));
+    }
+
+    #[test]
+    fn reused_contact_or_repeated_physical_down_recovers_a_missing_release() {
+        let mut s = state();
+        let mouse = DeviceId::dummy();
+        let origin = pos2(14.0, 23.0);
+        s.on_cursor_moved(mouse, origin);
+        s.on_mouse_button_input(mouse, Pressed, MouseButton::Left);
+        frame(&mut s);
+        s.on_cursor_left();
+        s.on_cursor_moved(mouse, origin);
+        s.on_mouse_button_input(mouse, Pressed, MouseButton::Left);
+        assert!(matches!(
+            s.egui_input.events.as_slice(),
+            [
+                Event::PointerMoved(_),
+                Event::PointerGone,
+                Event::PointerButton { pressed: true, .. }
+            ]
+        ));
+        s.on_mouse_button_input(mouse, Released, MouseButton::Left);
+        frame(&mut s);
+        assert!(!s.egui_ctx.input(|i| i.pointer.any_down()));
+
+        touch(&mut s, 3, TouchPhase::Start, 40.0);
+        frame(&mut s);
+        touch(&mut s, 3, TouchPhase::Start, 70.0);
+        assert!(matches!(
+            s.egui_input.events.as_slice(),
+            [
+                Event::Touch {
+                    phase: TouchPhase::Cancel,
+                    ..
+                },
+                Event::PointerGone,
+                Event::Touch {
+                    phase: TouchPhase::Start,
+                    ..
+                },
+                Event::PointerMoved(_),
+                Event::PointerButton { pressed: true, .. }
+            ]
+        ));
+        touch(&mut s, 3, TouchPhase::End, 70.0);
+        frame(&mut s);
+        assert!(!s.egui_ctx.input(|i| i.pointer.any_down()));
+    }
+
+    #[test]
+    fn physical_auxiliary_and_cancelled_touch_remain_independent() {
+        let mut s = state();
+        let mouse = DeviceId::dummy();
+        touch(&mut s, 1, TouchPhase::Start, 10.0);
+        s.on_cursor_moved(mouse, pos2(80.0, 20.0));
+        s.on_mouse_button_input(mouse, Pressed, MouseButton::Right);
+        touch(&mut s, 1, TouchPhase::Cancel, 10.0);
+        frame(&mut s);
+        assert!(
+            s.egui_ctx
+                .input(|i| !i.pointer.primary_down() && i.pointer.secondary_down())
+        );
+        s.on_mouse_button_input(mouse, Released, MouseButton::Right);
+        frame(&mut s);
+        assert!(s.egui_ctx.input(
+            |i| !i.pointer.any_down() && !i.pointer.button_clicked(PointerButton::Secondary)
+        ));
+    }
+
+    #[test]
+    fn focus_loss_ends_all_contacts_and_ignores_late_ups() {
+        let mut s = state();
+        let mouse = DeviceId::dummy();
+        touch(&mut s, 1, TouchPhase::Start, 10.0);
+        touch(&mut s, 2, TouchPhase::Start, 20.0);
+        s.on_cursor_moved(mouse, pos2(90.0, 20.0));
+        s.on_mouse_button_input(mouse, Pressed, MouseButton::Right);
+        s.cancel_pointers();
+        s.egui_input.events.push(Event::WindowFocused(false));
+        let n = s.egui_input.events.len();
+        touch(&mut s, 1, TouchPhase::End, 10.0);
+        touch(&mut s, 2, TouchPhase::Move, 25.0);
+        s.on_mouse_button_input(mouse, Released, MouseButton::Right);
+        assert_eq!(n, s.egui_input.events.len());
+        assert_eq!(
+            s.egui_input
+                .events
+                .iter()
+                .filter(|e| matches!(
+                    e,
+                    Event::Touch {
+                        phase: TouchPhase::Cancel,
+                        ..
+                    }
+                ))
+                .count(),
+            2
+        );
+        frame(&mut s);
+        assert!(!s.egui_ctx.input(|i| i.pointer.any_down()));
+    }
+
+    #[test]
+    fn simulated_mouse_touch_keeps_its_start_move_and_end() {
+        for button in [MouseButton::Left, MouseButton::Right] {
+            let mut s = state();
+            let mouse = DeviceId::dummy();
+            s.simulate_touch_screen = true;
+            s.on_cursor_moved(mouse, pos2(10.0, 20.0));
+            assert!(s.egui_input.events.is_empty());
+            s.on_mouse_button_input(mouse, Pressed, button);
+            s.on_cursor_moved(mouse, pos2(30.0, 20.0));
+            s.on_mouse_button_input(mouse, Released, button);
+            let phases: Vec<_> = s
+                .egui_input
+                .events
+                .iter()
+                .filter_map(|event| match event {
+                    Event::Touch { phase, .. } => Some(*phase),
+                    _ => None,
+                })
+                .collect();
+            assert_eq!(
+                phases,
+                [TouchPhase::Start, TouchPhase::Move, TouchPhase::End]
+            );
+            assert!(!s.is_any_pointer_button_down());
+        }
+    }
+}
