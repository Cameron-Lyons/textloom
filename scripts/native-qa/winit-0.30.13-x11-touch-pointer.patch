diff --git a/src/platform_impl/linux/x11/event_processor.rs b/src/platform_impl/linux/x11/event_processor.rs
--- a/src/platform_impl/linux/x11/event_processor.rs
+++ b/src/platform_impl/linux/x11/event_processor.rs
@@ -1137,7 +1137,14 @@
         // Set the timestamp.
         wt.xconn.set_timestamp(event.time as xproto::Timestamp);
 
-        let device_id = mkdid(event.deviceid as xinput::DeviceId);
+        // XI2 sends compatibility motion for touch through the master pointer.
+        // Preserve cursor geometry for clients, with the physical source ID of
+        // the contact that generated it. Ordinary mouse events keep their ID.
+        let device_id = if event.flags & xinput2::XIPointerEmulated != 0 {
+            mkdid(event.sourceid as xinput::DeviceId)
+        } else {
+            mkdid(event.deviceid as xinput::DeviceId)
+        };
         let window = event.event as xproto::Window;
         let window_id = mkwid(window);
         let new_cursor_pos = (event.event_x, event.event_y);
@@ -1402,6 +1409,7 @@
