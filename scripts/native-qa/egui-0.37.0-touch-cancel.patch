+#[cfg(test)]
+mod touch_cancel_tests {
+    use super::*;
+
+    #[test]
+    fn ordered_touch_cancel_releases_only_its_button_without_clicking() {
+        let device = TouchDeviceId(0);
+        let primary = TouchId(1);
+        let secondary = TouchId(2);
+        let button = |button| Event::PointerButton {
+            pos: Pos2::ZERO,
+            button,
+            pressed: true,
+            modifiers: Modifiers::NONE,
+        };
+        let cancel = |id| Event::Touch {
+            device_id: device,
+            id,
+            phase: TouchPhase::Cancel,
+            pos: Pos2::ZERO,
+            force: None,
+        };
+        let mut pointer = PointerState::default();
+        pointer.cancel_button_on_touch(device, primary, PointerButton::Primary);
+        let input = RawInput {
+            events: vec![
+                button(PointerButton::Secondary),
+                button(PointerButton::Primary),
+                cancel(secondary),
+                Event::PointerGone,
+            ],
+            ..Default::default()
+        };
+        let pointer = pointer.begin_pass(1.0, &input, InputOptions::default());
+        assert!(pointer.primary_down() && pointer.secondary_down());
+        let input = RawInput {
+            events: vec![cancel(primary), Event::PointerGone],
+            ..Default::default()
+        };
+        let pointer = pointer.begin_pass(2.0, &input, InputOptions::default());
+        assert!(!pointer.primary_down() && pointer.secondary_down());
+        assert!(pointer.button_released(PointerButton::Primary));
+        assert!(!pointer.primary_clicked());
+        assert!(!pointer.button_released(PointerButton::Secondary));
+    }
+}
