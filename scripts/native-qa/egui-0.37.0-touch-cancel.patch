+#[cfg(test)]
+mod capture_tests {
+    use super::*;
+    use crate::{TouchId, TouchPhase, pos2};
+
+    fn button(button: PointerButton, pressed: bool, x: f32) -> Event {
+        Event::PointerButton {
+            pos: pos2(x, 0.0),
+            button,
+            pressed,
+            modifiers: Modifiers::NONE,
+        }
+    }
+
+    fn pass(pointer: PointerState, events: Vec<Event>) -> PointerState {
+        pointer.begin_pass(
+            1.0,
+            &RawInput {
+                events,
+                ..Default::default()
+            },
+            InputOptions::default(),
+        )
+    }
+
+    #[test]
+    fn earlier_disappearance_cannot_consume_a_later_physical_cancellation() {
+        use PointerButton::Primary;
+        let mut pointer = PointerState::default();
+        pointer.set_explicit_capture(true);
+        let touch = |phase| Event::Touch {
+            device_id: TouchDeviceId(0),
+            id: TouchId(17),
+            phase,
+            pos: pos2(10.0, 0.0),
+            force: None,
+        };
+        // Input hooks may defer the entire sequence until a single egui pass.
+        let pointer = pass(
+            pointer,
+            vec![
+                touch(TouchPhase::Start),
+                button(Primary, true, 10.0),
+                touch(TouchPhase::Cancel),
+                Event::PointerGone,
+                Event::PointerGone,
+                button(Primary, true, 90.0),
+                Event::PointerGone,
+            ],
+        );
+        assert!(!pointer.any_down() && !pointer.any_click());
+        assert_eq!(
+            pointer
+                .pointer_events
+                .iter()
+                .filter(|event| event.is_release())
+                .count(),
+            2
+        );
+    }
+
+    #[test]
+    fn auxiliary_release_preserves_primary_geometry_and_widget_capture() {
+        use PointerButton::{Primary, Secondary};
+        let mut pointer = PointerState::default();
+        pointer.set_explicit_capture(true);
+        pointer.queue_auxiliary_release(Secondary, true);
+        let pointer = pass(
+            pointer,
+            vec![
+                button(Primary, true, 10.0),
+                button(Secondary, true, 90.0),
+                button(Secondary, false, 90.0),
+            ],
+        );
+        assert!(pointer.primary_down() && pointer.button_released(Secondary));
+        assert!(!pointer.secondary_down() && !pointer.any_click());
+        assert_eq!(pointer.press_origin(), Some(pos2(10.0, 0.0)));
+        assert_eq!(pointer.interact_pos(), Some(pos2(10.0, 0.0)));
+        assert!(matches!(
+            pointer.pointer_events.last(),
+            Some(PointerEvent::AuxiliaryReleased(Secondary))
+        ));
+    }
+
+    #[test]
+    fn auxiliary_releases_follow_their_own_button_in_input_order() {
+        use PointerButton::{Middle, Secondary};
+        let mut pointer = PointerState::default();
+        pointer.set_explicit_capture(true);
+        pointer.queue_auxiliary_release(Secondary, false);
+        pointer.queue_auxiliary_release(Middle, true);
+        pointer.queue_auxiliary_release(Secondary, true);
+        let pointer = pass(
+            pointer,
+            vec![
+                button(Secondary, true, 10.0),
+                button(Secondary, false, 10.0),
+                button(Middle, true, 10.0),
+                button(Middle, false, 10.0),
+                button(Secondary, true, 10.0),
+                button(Secondary, false, 10.0),
+            ],
+        );
+        let releases: Vec<_> = pointer
+            .pointer_events
+            .iter()
+            .filter_map(|e| {
+                if let PointerEvent::Released { button, click } = e {
+                    Some((*button, click.is_some()))
+                } else {
+                    None
+                }
+            })
+            .collect();
+        assert_eq!(
+            releases,
+            [(Secondary, true), (Middle, false), (Secondary, false)]
+        );
+    }
+
+    #[test]
+    fn focus_loss_cancels_every_button_only_in_explicit_capture_mode() {
+        use PointerButton::{Primary, Secondary};
+        for enabled in [false, true] {
+            let mut pointer = PointerState::default();
+            pointer.set_explicit_capture(enabled);
+            let pointer = pass(
+                pointer,
+                vec![
+                    button(Secondary, true, 10.0),
+                    button(Primary, true, 10.0),
+                    Event::WindowFocused(false),
+                ],
+            );
+            assert_eq!(pointer.primary_down(), !enabled);
+            assert_eq!(pointer.secondary_down(), !enabled);
+            assert!(!pointer.any_click());
+        }
+    }
