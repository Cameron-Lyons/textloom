+    /// Use integration-managed capture. During a primary gesture the integration
+    /// must retain the pointer across surface boundaries and submit [`Event::PointerGone`]
+    /// only when capture ends. A disappearance then cancels primary without a click.
+    /// A genuine [`Event::WindowFocused(false)`] cancels all buttons.
+    pub fn set_explicit_capture(&mut self, enabled: bool) {
+        self.explicit_capture = enabled;
+        if !enabled {
+            self.auxiliary_releases.clear();
+        }
+    }
+
+    /// Record the disposition of an auxiliary button release before submitting its
+    /// [`Event::PointerButton`]. Record every release for that button in input order,
+    /// including ordinary releases. The matching raw input can be deferred to a later pass.
+    pub fn queue_auxiliary_release(&mut self, button: PointerButton, cancelled: bool) {
+        debug_assert_ne!(button, PointerButton::Primary);
+        self.auxiliary_releases.push_back((button, cancelled));
+    }
